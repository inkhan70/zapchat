# ZapChat Environment Variables
PORT=5000
CLIENT_URL=http://localhost:3000
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
NODE_ENV=development

# Optional — MongoDB. If unset, the server falls back to in-memory storage.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/zapchat

# ─── Password Reset / Email ────────────────────────────────────────────────
# When MOCK_EMAIL=true (default) the server logs the reset link to the
# console instead of sending real mail. Set MOCK_EMAIL=false and provide
# SMTP_* values to send real emails through nodemailer-compatible SMTP.
MOCK_EMAIL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ZapChat <no-reply@zapchat.local>"

# Public base URL used when composing password-reset links.
# In dev, leave this empty and the server will derive it from the request.
RESET_LINK_BASE=

# ─── Profile Picture Uploads ────────────────────────────────────────────────
# Absolute or relative (to server/) directory where uploaded profile pictures
# are stored. The default "./uploads" is created on boot if missing.
UPLOAD_DIR=./uploads
# Max upload size in bytes (default 5 MB).
UPLOAD_MAX_BYTES=5242880

# ─── Metered Video SDK ──────────────────────────────────────────────────────
# App domain is the subdomain of your Metered app (no protocol, no path).
# Get it from the Metered dashboard home page after signup.
METERED_APP_DOMAIN=zapchat-server.metered.live

# Server-side REST secret. KEEP PRIVATE. Rotate from the Metered dashboard
# "Developers" tab if it ever leaks. Never commit the real value to git.
METERED_SECRET_KEY=your_metered_secret_key_here